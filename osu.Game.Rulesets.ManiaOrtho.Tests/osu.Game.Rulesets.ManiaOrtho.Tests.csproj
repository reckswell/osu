<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="Project">
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <StartupObject>osu.Game.Rulesets.ManiaOrtho.Tests.Program</StartupObject>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>
  <ItemGroup Label="Package References">
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0"/>
    <PackageReference Include="NUnit" Version="4.6.1"/>
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0"/>
  </ItemGroup>
  <ItemGroup Label="Project References">
    <ProjectReference Include="..\osu.Game\osu.Game.csproj"/>
    <ProjectReference Include="..\osu.Game.Rulesets.Mania\osu.Game.Rulesets.Mania.csproj"/>
    <!-- Only for tests that switch away from maniaortho (present beatmap). -->
    <ProjectReference Include="..\osu.Game.Rulesets.Osu\osu.Game.Rulesets.Osu.csproj"/>
    <ProjectReference Include="..\osu.Game.Rulesets.ManiaOrtho\osu.Game.Rulesets.ManiaOrtho.csproj"/>
    <!-- The osu.exe launcher's logic (folders, ini files, screenshots), tested without starting a game. -->
    <ProjectReference Include="..\ManiaOrtho.Launcher\ManiaOrtho.Launcher.csproj"/>
  </ItemGroup>
</Project>
